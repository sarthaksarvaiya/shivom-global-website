# SHIVOM GLOBAL — Environment Variables Template
# Copy this file to .env.local for local testing.
# NEVER commit real credentials to Git or GitHub.
# In Vercel, configure these variables in: Project Settings -> Environment Variables.

# Supabase Project Configuration (Serverless Function System of Record)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional Email Notification (Trade Desk Dispatch)
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=
